// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  roles       Role[]
  auditLogs   AuditLog[]
  sampleItems       SampleItem[]
  articleCategories ArticleCategory[]
  articles          Article[]
  departments       Department[]
  personnelProfiles PersonnelProfile[]
  programs          Program[]
  courses           Course[]
  teachingAssignments TeachingAssignment[]
  classSchedules    ClassSchedule[]
  students          Student[]
  advisingRecords   AdvisingRecord[]
  studentScholarships StudentScholarship[]
  documents           Document[]
  documentApprovals   DocumentApproval[]
  documentHistories   DocumentHistory[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants       UserTenant[]
  authTokens        AuthToken[]
  auditLogs         AuditLog[]         @relation("AuditActor")
  articles          Article[]
  personnelProfiles PersonnelProfile[]
  students          Student[]
  createdDocuments  Document[]         @relation("DocumentCreator")
  documentApprovals DocumentApproval[] @relation("DocumentApprover")
  documentHistories DocumentHistory[]  @relation("DocumentHistoryActor")

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

// ==========================================
// 1. ระบบจัดการข่าวสารประชาสัมพันธ์ (News & PR)
// ==========================================
model ArticleCategory {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  nameTh     String   @map("name_th") @db.VarChar(100)
  nameEn     String   @map("name_en") @db.VarChar(100)
  slug       String   @db.VarChar(100)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles Article[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("article_categories")
}

model Article {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  categoryId    String    @map("category_id") @db.Uuid
  titleTh       String    @map("title_th") @db.VarChar(255)
  titleEn       String    @map("title_en") @db.VarChar(255)
  slug          String    @db.VarChar(255)
  excerptTh     String?   @map("excerpt_th") @db.Text
  excerptEn     String?   @map("excerpt_en") @db.Text
  contentTh     String    @map("content_th") @db.Text
  contentEn     String    @map("content_en") @db.Text
  coverImageUrl String?   @map("cover_image_url") @db.VarChar(500)
  authorId      String?   @map("author_id") @db.Uuid
  status        String    @default("DRAFT") @db.VarChar(30)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz()
  isPinned      Boolean   @default(false) @map("is_pinned")
  viewCount     Int       @default(0) @map("view_count")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category    ArticleCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  author      User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  attachments ArticleAttachment[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, isPinned])
  @@map("articles")
}

model ArticleAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  articleId String   @map("article_id") @db.Uuid
  fileName  String   @map("file_name") @db.VarChar(255)
  fileUrl   String   @map("file_url") @db.VarChar(500)
  fileSize  Int?     @map("file_size")
  fileType  String?  @map("file_type") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_attachments")
}

// ==========================================
// 2. ระบบจัดการบุคลากร (Personnel)
// ==========================================
model Department {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  nameTh     String   @map("name_th") @db.VarChar(255)
  nameEn     String   @map("name_en") @db.VarChar(255)
  code       String   @db.VarChar(50)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personnel PersonnelProfile[]
  programs  Program[]
  documents Document[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("departments")
}

model PersonnelProfile {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  personnelCode       String?  @map("personnel_code") @db.VarChar(50)
  citizenIdEncrypted  String?  @map("citizen_id_encrypted") @db.Text
  citizenIdMasked     String?  @map("citizen_id_masked") @db.VarChar(30)
  monasticTitle       String?  @map("monastic_title") @db.VarChar(100)
  chaya               String?  @map("chaya") @db.VarChar(50)
  paliDegree          String?  @map("pali_degree") @db.VarChar(30)
  templeName          String?  @map("temple_name") @db.VarChar(255)
  address             String?  @db.Text
  academicRank  String?  @map("academic_rank") @db.VarChar(50)
  firstNameTh   String   @map("first_name_th") @db.VarChar(100)
  lastNameTh    String   @map("last_name_th") @db.VarChar(100)
  firstNameEn   String   @map("first_name_en") @db.VarChar(100)
  lastNameEn    String   @map("last_name_en") @db.VarChar(100)
  departmentId  String?  @map("department_id") @db.Uuid
  positionTh    String   @map("position_th") @db.VarChar(150)
  positionEn    String   @map("position_en") @db.VarChar(150)
  personnelType String   @default("ACADEMIC") @map("personnel_type") @db.VarChar(30)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  phoneExt      String?  @map("phone_ext") @db.VarChar(50)
  roomNumber    String?  @map("room_number") @db.VarChar(50)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  biographyTh   String?  @map("biography_th") @db.Text
  biographyEn   String?  @map("biography_en") @db.Text
  expertise     Json     @default("[]") @db.JsonB
  orderIndex    Int      @default(0) @map("order_index")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  works               AcademicWork[]
  teachingAssignments TeachingAssignment[]
  classSchedules      ClassSchedule[]
  advisedStudents     Student[]            @relation("AdvisorStudents")
  advisingRecords     AdvisingRecord[]     @relation("AdvisorAdvisingRecords")

  @@index([tenantId, isActive, orderIndex])
  @@index([tenantId, personnelCode])
  @@index([departmentId])
  @@map("personnel_profiles")
}

model AcademicWork {
  id           String   @id @default(uuid()) @db.Uuid
  personnelId  String   @map("personnel_id") @db.Uuid
  title        String   @db.VarChar(500)
  workType     String   @default("JOURNAL") @map("work_type") @db.VarChar(50)
  year         Int?
  citationText String?  @map("citation_text") @db.Text
  url          String?  @db.VarChar(500)
  doi          String?  @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  personnel PersonnelProfile @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@index([personnelId])
  @@map("academic_works")
}

// ==========================================
// 3. ระบบจัดการหลักสูตร (Curriculum)
// ==========================================
model Program {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  departmentId           String?  @map("department_id") @db.Uuid
  code                   String   @db.VarChar(50)
  nameTh                 String   @map("name_th") @db.VarChar(255)
  nameEn                 String   @map("name_en") @db.VarChar(255)
  degreeLevel            String   @map("degree_level") @db.VarChar(30)
  degreeNameTh           String   @map("degree_name_th") @db.VarChar(255)
  degreeNameEn           String   @map("degree_name_en") @db.VarChar(255)
  totalCredits           Int      @map("total_credits")
  tuitionFee             String?  @map("tuition_fee") @db.VarChar(100)
  durationYears          Int      @default(4) @map("duration_years")
  descriptionTh          String?  @map("description_th") @db.Text
  descriptionEn          String?  @map("description_en") @db.Text
  careerOpportunitiesTh String?  @map("career_opportunities_th") @db.Text
  careerOpportunitiesEn String?  @map("career_opportunities_en") @db.Text
  pdfUrl                 String?  @map("pdf_url") @db.VarChar(500)
  isOpenAdmission        Boolean  @default(false) @map("is_open_admission")
  status                 String   @default("ACTIVE") @db.VarChar(30)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  studyPlans          ProgramStudyPlan[]
  programCourses      ProgramCourse[]
  teachingAssignments TeachingAssignment[]
  classSchedules      ClassSchedule[]
  students            Student[]

  @@unique([tenantId, code])
  @@index([tenantId, status, degreeLevel])
  @@map("programs")
}

model ProgramStudyPlan {
  id         String   @id @default(uuid()) @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  nameTh     String   @map("name_th") @db.VarChar(100)
  nameEn     String   @map("name_en") @db.VarChar(100)
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("program_study_plans")
}

model Course {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  code           String   @db.VarChar(50)
  nameTh         String   @map("name_th") @db.VarChar(255)
  nameEn         String   @map("name_en") @db.VarChar(255)
  credits        String   @db.VarChar(30)
  courseCategory String?  @map("course_category") @db.VarChar(100)
  descriptionTh  String?  @map("description_th") @db.Text
  descriptionEn  String?  @map("description_en") @db.Text
  prerequisite   String?  @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  programCourses      ProgramCourse[]
  teachingAssignments TeachingAssignment[]
  classSchedules      ClassSchedule[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("courses")
}

model ProgramCourse {
  id          String   @id @default(uuid()) @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  courseGroup String   @map("course_group") @db.VarChar(100)
  yearLevel   Int      @default(1) @map("year_level")
  semester    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([programId, courseId])
  @@index([programId, yearLevel, semester])
  @@map("program_courses")
}

model TeachingAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  personnelId  String   @map("personnel_id") @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  programId    String?  @map("program_id") @db.Uuid
  academicYear Int      @default(2569) @map("academic_year")
  semester     Int      @default(1)
  role         String   @default("PRIMARY") @db.VarChar(50)
  section      String   @default("01") @db.VarChar(20)
  hoursPerWeek Int      @default(3) @map("hours_per_week")
  studentCount Int      @default(0) @map("student_count")
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  personnel PersonnelProfile @relation(fields: [personnelId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  program   Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@index([tenantId, academicYear, semester])
  @@index([personnelId])
  @@index([courseId])
  @@index([programId])
  @@map("teaching_assignments")
}

model ClassSchedule {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  scheduleCode String   @map("schedule_code") @db.VarChar(50)
  programId    String   @map("program_id") @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  personnelId  String   @map("personnel_id") @db.Uuid
  academicYear Int      @default(2569) @map("academic_year")
  semester     Int      @default(1)
  yearLevel    Int      @default(1) @map("year_level")
  dayOfWeek    Int      @map("day_of_week")
  startTime    String   @map("start_time") @db.VarChar(10)
  endTime      String   @map("end_time") @db.VarChar(10)
  room         String   @db.VarChar(100)
  building     String?  @db.VarChar(100)
  section      String   @default("01") @db.VarChar(20)
  classType    String   @default("LECTURE") @map("class_type") @db.VarChar(30)
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  program   Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  personnel PersonnelProfile @relation(fields: [personnelId], references: [id], onDelete: Cascade)

  @@index([tenantId, academicYear, semester, yearLevel])
  @@index([personnelId])
  @@index([courseId])
  @@index([room])
  @@map("class_schedules")
}

// ==========================================
// 4. ระบบบริหารจัดการนิสิตและอาจารย์ที่ปรึกษา (Student Management & Academic Advising)
// ==========================================

model Student {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  studentCode   String   @map("student_code") @db.VarChar(50)
  title         String   @default("นาย") @db.VarChar(50)
  firstNameTh   String   @map("first_name_th") @db.VarChar(100)
  lastNameTh    String   @map("last_name_th") @db.VarChar(100)
  firstNameEn   String   @map("first_name_en") @db.VarChar(100)
  lastNameEn    String   @map("last_name_en") @db.VarChar(100)
  programId     String   @map("program_id") @db.Uuid
  advisorId     String?  @map("advisor_id") @db.Uuid
  admissionYear Int      @map("admission_year")
  status        String   @default("STUDYING") @db.VarChar(30)
  gpa           Decimal  @default(0.00) @db.Decimal(4, 2)
  email         String?  @db.VarChar(255)
  phone         String?  @db.VarChar(50)
  avatarUrl     String?  @map("avatar_url") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  program         Program              @relation(fields: [programId], references: [id], onDelete: Restrict)
  advisor         PersonnelProfile?    @relation("AdvisorStudents", fields: [advisorId], references: [id], onDelete: SetNull)
  advisingRecords AdvisingRecord[]
  scholarships    StudentScholarship[]

  @@unique([tenantId, studentCode])
  @@index([tenantId, status])
  @@index([tenantId, admissionYear])
  @@index([programId])
  @@index([advisorId])
  @@map("students")
}

model AdvisingRecord {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  advisorId      String   @map("advisor_id") @db.Uuid
  date           DateTime @default(now()) @db.Timestamptz()
  topic          String   @db.VarChar(255)
  detail         String   @db.Text
  actionPlan     String?  @map("action_plan") @db.Text
  isConfidential Boolean  @default(false) @map("is_confidential")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  advisor PersonnelProfile @relation("AdvisorAdvisingRecords", fields: [advisorId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([advisorId])
  @@map("advising_records")
}

model StudentScholarship {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  studentId       String   @map("student_id") @db.Uuid
  scholarshipName String   @map("scholarship_name") @db.VarChar(255)
  academicYear    Int      @map("academic_year")
  amount          Decimal  @default(0.00) @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@index([academicYear])
  @@map("student_scholarships")
}

// ==========================================
// 4. ระบบบริหารจัดการและอนุมัติเอกสาร (E-Document & Approval)
// ==========================================
model Document {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  documentNumber  String   @map("document_number") @db.VarChar(100)
  title           String   @db.VarChar(255)
  category        String   @default("GENERAL") @db.VarChar(50)
  urgency         String   @default("NORMAL") @db.VarChar(30)
  confidentiality String   @default("NORMAL") @db.VarChar(30)
  senderName      String   @map("sender_name") @db.VarChar(255)
  recipientName   String   @map("recipient_name") @db.VarChar(255)
  summary         String   @db.Text
  attachmentUrl   String?  @map("attachment_url") @db.VarChar(500)
  status          String   @default("DRAFT") @db.VarChar(30)
  departmentId    String?  @map("department_id") @db.Uuid
  createdById     String   @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department  Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator     User               @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvals   DocumentApproval[]
  histories   DocumentHistory[]

  @@unique([tenantId, documentNumber])
  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, urgency])
  @@index([createdById])
  @@index([departmentId])
  @@map("documents")
}

model DocumentApproval {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  documentId   String    @map("document_id") @db.Uuid
  approverId   String    @map("approver_id") @db.Uuid
  stepOrder    Int       @map("step_order")
  roleTitle    String    @map("role_title") @db.VarChar(150)
  status       String    @default("PENDING") @db.VarChar(30)
  comment      String?   @db.Text
  signatureUrl String?   @map("signature_url") @db.VarChar(500)
  actedAt      DateTime? @map("acted_at") @db.Timestamptz()
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approver User     @relation("DocumentApprover", fields: [approverId], references: [id], onDelete: Restrict)

  @@index([tenantId, approverId, status])
  @@index([documentId, stepOrder])
  @@map("document_approvals")
}

model DocumentHistory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  documentId  String   @map("document_id") @db.Uuid
  actorId     String   @map("actor_id") @db.Uuid
  action      String   @db.VarChar(50)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User     @relation("DocumentHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, documentId])
  @@map("document_histories")
}

